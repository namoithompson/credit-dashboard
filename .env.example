
# For local dev you can point to file-based SQLite via Prisma
DB_PROVIDER="postgresql" # use "sqlite" locally if preferred
DATABASE_URL="postgresql://user:password@localhost:5432/credit_dashboard?schema=public"
# For SQLite example:
# DB_PROVIDER="sqlite"
# DATABASE_URL="file:./dev.db"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-long-random-string"
FILE_STORAGE_ROOT="./uploads"
